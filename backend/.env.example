NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urgent_medicine
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=urgent_medicine_session
SESSION_TTL_DAYS=7
DELIVERY_CHARGE_BDT=220
AUTH_PEPPER=replace-with-a-long-random-secret
VERIFICATION_PROVIDER=console
# Production full verification workflow: resend-twilio
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=Urgent Medicine <noreply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
VERIFICATION_REQUEST_TIMEOUT_MS=15000
COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=urgent_medicine_csrf

# Step 3 - Bangladesh medicine catalogue ingestion
OCL_BASE_URL=https://tr.ocl.dghs.gov.bd
OCL_COLLECTION_PATH=/orgs/MoHFW/collections/dgda-registered-drugs-valueset/
OCL_API_TOKEN=
OCL_PAGE_SIZE=250
CATALOG_MAX_RECORDS=100000
CATALOG_REQUEST_TIMEOUT_MS=30000

# Step 5 private prescription file storage. Production: use a persistent private volume
# or, preferably, an S3-compatible private object-storage adapter when implemented.
PRIVATE_UPLOAD_DIR=./storage/private

# Step 6 - Payments
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
PAYMENT_PUBLIC_BASE_URL=http://localhost:4000
PAYMENT_REQUEST_TIMEOUT_MS=30000

# Step 9 - Operations
LOG_LEVEL=info
APP_VERSION=<git commit/tag>
CORS_MAX_AGE_SECONDS=600
MIGRATIONS_DIR=../database/migrations
